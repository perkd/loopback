{
  "name": "@perkd/loopback",
  "version": "3.38.1",
  "description": "LoopBack: Open Source Framework for Node.js",
  "copyright.owner": "IBM Corp.",
  "license": "MIT",
  "author": "IBM Corp.",
  "homepage": "https://github.com/perkd/loopback#readme",
  "keywords": [
    "web",
    "restful",
    "rest",
    "api",
    "express",
    "restify",
    "koa",
    "auth",
    "security",
    "oracle",
    "mysql",
    "nosql",
    "mongo",
    "mongodb",
    "sqlserver",
    "mssql",
    "postgres",
    "postgresql",
    "soap",
    "StrongLoop",
    "framework",
    "mobile",
    "mBaaS"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "coverage": "c8 report",
    "report-coverage": "c8 report --reporter=lcov && cat ./coverage/lcov.info | coveralls",
    "test": "c8 mocha test/**/*.js --exit --timeout 5000 --color --reporter spec",
    "test:compatibility": "mocha test/express-compatibility.test.js --timeout 15000 --color --reporter spec",
    "test:performance": "mocha test/middleware-performance.test.js --timeout 15000 --color --reporter spec",
    "test:concurrency": "mocha test/middleware-concurrency.test.js --timeout 20000 --color --reporter spec",
    "test:multitenant": "mocha test/multitenant-dispatch.test.js --timeout 5000 --color --reporter spec",
    "test:middleware": "npm run test:compatibility && npm run test:performance && npm run test:concurrency",
    "update": "ncu -u -x inflection -x is-docker -x chai -x sinon-chai -x dirty-chai",
    "reinstall": "rm -rf node_modules/ && rm yarn.lock && yarn install"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/perkd/loopback.git"
  },
  "bugs": {
    "url": "https://github.com/perkd/loopback/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "files": [
    "index.js",
    "lib",
    "common",
    "server",
    "client",
    "intl",
    "README.md",
    "CHANGES.md",
    "favicon.ico"
  ],
  "browser": {
    "./lib/server-app.js": "./lib/browser-express.js",
    "bcrypt": false,
    "connect": false,
    "depd": "loopback-datasource-juggler/lib/browser.depd.js",
    "express": "./lib/browser-express.js",
    "nodemailer": false,
    "supertest": false
  },
  "config": {
    "ci": {
      "debug": "*,-mocha:*,-eslint:*"
    }
  },
  "ci": {
    "downstreamIgnoreList": [
      "bluemix-service-broker",
      "gateway-director-bluemix",
      "plan-manager"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.3.0",
    "debug": "^4.4.3",
    "depd": "^2.0.0",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "fast-json-stable-stringify": "^2.1.0",
    "inflection": "2.0.1",
    "isemail": "^3.2.0",
    "loopback-connector-remote": "npm:@perkd/loopback-connector-remote@^3.6.0",
    "loopback-datasource-juggler": "npm:@perkd/loopback-datasource-juggler@^6.1.0",
    "loopback-filters": "^1.1.1",
    "loopback-phase": "3.4.0",
    "nodemailer": "^9.0.5",
    "nodemailer-direct-transport": "^3.3.2",
    "nodemailer-stub-transport": "^1.1.0",
    "serve-favicon": "^2.5.1",
    "stable": "^0.1.8",
    "strong-globalize": "^6.0.6",
    "strong-remoting": "npm:@perkd/strong-remoting@^3.22.0",
    "uid2": "1.0.0",
    "underscore.string": "^3.3.6"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.0.1",
    "@stylistic/eslint-plugin-js": "^4.4.1",
    "browserify": "^17.0.1",
    "c8": "^12.0.0",
    "chai": "4.2.0",
    "cookie-parser": "^1.4.7",
    "coveralls": "^3.1.1",
    "dirty-chai": "2.0.1",
    "eslint": "^10.8.1",
    "eslint-config-loopback": "^14.0.0",
    "eslint-plugin-jsonc": "^3.4.1",
    "eslint-plugin-mocha": "^12.0.2",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-security": "^4.0.1",
    "express-session": "^1.19.0",
    "is-docker": "2.2.1",
    "loopback-boot": "^3.3.1",
    "loopback-context": "3.5.2",
    "mocha": "^11.8.0",
    "sinon": "^22.1.0",
    "sinon-chai": "3.7.0",
    "strong-error-handler": "^5.0.31",
    "strong-task-emitter": "^0.0.8",
    "supertest": "^7.2.2"
  },
  "packageManager": "yarn@4.18.0"
}
